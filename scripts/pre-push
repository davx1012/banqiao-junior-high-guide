#!/bin/sh
# 推送 main 分支到 GitHub 時，同步部署到 Cloudflare。
# 安裝：cp scripts/pre-push .git/hooks/pre-push
# 部署失敗不會擋住 GitHub 推送，只會顯示警告。

deploy_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] && deploy_main=1
done

[ "$deploy_main" = "1" ] || exit 0

export PATH="$PATH:/c/Program Files/nodejs"
cd "$(git rev-parse --show-toplevel)" || exit 0

echo "[pre-push] 部署到 Cloudflare..."
if npx --yes wrangler deploy --message "$(git log -1 --pretty=%s)"; then
  echo "[pre-push] Cloudflare 部署完成"
else
  echo "[pre-push] 警告：Cloudflare 部署失敗，GitHub 推送仍會繼續" >&2
fi
exit 0
